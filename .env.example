NODE_ENV=development
PORT=5000
CLIENT_ORIGINS=http://localhost:5173
MONGO_URI=mongodb://mongo:27017/unicart?replicaSet=rs0
MONGO_POOL_SIZE=50
REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=change_me_to_64_random_bytes
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict
# For separate frontend deployment (e.g., Vercel/Netlify pointing to remote backend):
# VITE_API_URL=https://your-api-domain.com/api/v1
ADMIN_EMAIL=admin@unicart.dev
ADMIN_PASSWORD=ChangeMe123!
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Google OAuth 2.0 Credentials (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
LOG_LEVEL=info
