{
  "name": "unicart",
  "version": "1.0.0",
  "private": true,
  "description": "UniCart — Fast, Secure, Scalable MERN Stack E-commerce Marketplace",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,cyan\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "lint": "npm run lint --workspace=server && npm run lint --workspace=client",
    "test": "npm run test --workspace=server",
    "seed": "npm run seed --workspace=server",
    "create-admin": "npm run create-admin --workspace=server --",
    "purge": "npm run purge --workspace=server",
    "worker": "npm run worker --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
